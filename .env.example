# Lens 공통 환경변수 예시
# CP235 — backend/app/* 와 backend/collector/* 가 읽는 모든 키를 1:1 동기화.

# ── Frontend ──────────────────────────────────────────────────────────
# 프론트가 호출할 백엔드 API 주소.
# 배포 환경에서는 반드시 Render URL을 명시한다.
NEXT_PUBLIC_BACKEND_URL=https://lens-backend-7stj.onrender.com

# 로컬 개발 시에만 아래 값을 사용한다.
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ── Backend Cors ──────────────────────────────────────────────────────
# CSV. 기본 = http://localhost:3000,http://127.0.0.1:3000,
#               https://lens-kimjihyeong-s-projects.vercel.app,
#               https://lens-ten-delta.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Vercel preview alias 자동 허용 정규식. 기본 = ^https://lens(?:-[a-z0-9-]+)?\.vercel\.app$
BACKEND_CORS_ORIGIN_REGEX=

# ── Database (Supabase) ───────────────────────────────────────────────
# 선택. v1 local-parquet 제품 화면은 미설정으로 동작 (LENS_FORCE_LOCAL=1과 동등).
# CP254 컷오버: 이 두 개만 채우면 서빙 read 가 Supabase REST 로 전환된다
# (정본 토글 = app/services/data_backend.py use_supabase()).
# 우선순위: LENS_DATA_BACKEND=local류 > LENS_USE_LOCAL_SNAPSHOTS > LENS_FORCE_LOCAL
#           > URL/KEY 구성 여부.
SUPABASE_URL=
SUPABASE_KEY=
# 1/true/yes 이면 SUPABASE 설정이 있어도 강제로 local parquet 경로 사용. 기본 = 0.
# 컷오버 후 문제 발생 시 이 한 줄이 즉시 롤백 스위치다.
LENS_FORCE_LOCAL=0

# ── Database 직접연결 (리허설/스키마 적용 전용 — 서빙은 REST만 사용) ──
# db/scripts/ensure_runtime_schema.py, test_connection.py 의 psycopg2 직접연결용.
# 로컬 Supabase 리허설(CP254 P5) 또는 클라우드 psql 스키마 적용 때만 채운다.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=require

# ── Market data ───────────────────────────────────────────────────────
# app 기본 = yfinance (backend/app/repositories/market_repo.py).
# collector 기본 = yahoo (backend/collector/config.py).
# 둘이 의도적으로 다름 — collector 는 별도 파이프라인.
MARKET_DATA_PROVIDER=yfinance
# collector 도메인 - market fallback provider (collector/config.py).
MARKET_DATA_FALLBACK_PROVIDER=eodhd

# ── Local snapshots ───────────────────────────────────────────────────
# 1 이면 SUPABASE 대신 local parquet (start_demo.ps1 이 기본 주입).
LENS_USE_LOCAL_SNAPSHOTS=1
# parquet 디렉토리. start_demo.ps1 가 <root>/data/parquet 주입.
LENS_LOCAL_SNAPSHOT_DIR=
# collector 도메인 - "local" | "supabase" 등. (collector/local_snapshots.py).
LENS_DATA_BACKEND=
# collector 도메인 - 1 이면 local 스냅샷 강제 (없으면 에러).
LENS_REQUIRE_LOCAL_SNAPSHOTS=

# ── Cache / Admin ─────────────────────────────────────────────────────
# 1 이면 startup 시 v1 predictions parquet eager load. 기본 = 0 (lazy).
LENS_EAGER_V1_CACHE=0
# admin /reload endpoint 호출 토큰. 비어 있고 LOCAL_ADMIN_RELOAD 도 false면 reload 불가.
LENS_ADMIN_RELOAD_TOKEN=
# 1/true/yes 이면 localhost 요청 한정 reload 허용. 기본 = 0.
LENS_ALLOW_LOCAL_ADMIN_RELOAD=0

# ── External APIs ─────────────────────────────────────────────────────
# 선택. FRED 거시지표 / FMP 재무지표 / EODHD 가격.
FRED_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=
